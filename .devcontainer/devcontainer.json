{
  "name": "Module 2 : Bonus Task System Exploitation Lab (10 Points)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "workspaceFolder": "/workspaces/system-exploitation-lab",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  "updateContentCommand": "sudo chmod +x .devcontainer/setup.sh && bash -lc .devcontainer/setup.sh",

  "postStartCommand": "bash -lc 'sudo mkdir -p /run/sshd && sudo ssh-keygen -A >/dev/null 2>&1 || true && sudo /usr/sbin/sshd -D >/tmp/sshd.log 2>&1 & echo -e \"\\n✅ SSHD started (localhost only).\\nRun: hydra -L users.txt -P passwords.txt ssh://localhost\\n\"'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "njpwerner.autodocstring",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },

  "remoteUser": "vscode",

  "portsAttributes": {
    "22": {
      "label": "Local SSH (for lab use only)",
      "onAutoForward": "ignore"
    }
  }
}
