{
  "name": "Module 2 : Bonus Task System & Web Exploitation Lab (20 Points)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  "updateContentCommand": "sudo chmod +x .devcontainer/setup.sh && bash -lc .devcontainer/setup.sh",

  "postStartCommand": "bash -lc 'chmod +x scripts/*.sh apps/*.sh 2>/dev/null; scripts/start_services.sh'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "njpwerner.autodocstring",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },

  "remoteUser": "vscode",

  "portsAttributes": {
    "22": {
      "label": "Local SSH (for lab use only)",
      "onAutoForward": "ignore"
    },
    "8080": {
      "label": "DoS target app (Task 5)",
      "onAutoForward": "ignore"
    },
    "5001": {
      "label": "Session hijacking app (Task 6)",
      "onAutoForward": "ignore"
    },
    "5002": {
      "label": "SQL injection app (Task 8)",
      "onAutoForward": "ignore"
    },
    "8000": {
      "label": "Web recon site (Task 7)",
      "onAutoForward": "ignore"
    }
  }
}

